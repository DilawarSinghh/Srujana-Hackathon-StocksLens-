# ---------------------------------------------------------------------------
# StockLens environment variables
# Copy this file to `.env.local` (Next.js) / `.env` (scripts) and fill in.
# Never commit real values.
# ---------------------------------------------------------------------------

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — SERVER + SCRIPTS ONLY. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# LLM inference — Groq ONLY. Groq is the single permitted LLM inference
# provider for StockLens. Server only; never expose to the browser.
# Get a key at https://console.groq.com and a model id from
# https://console.groq.com/docs/models (verify your account can use it).
# ---------------------------------------------------------------------------
GROQ_API_KEY=your-groq-api-key
# Default Groq chat model, used when LLM_CHAT_CHAIN is unset.
GROQ_MODEL=openai/gpt-oss-20b
# Optional ordered Groq-model fallback chain (comma-separated `groq:<model-id>`
# entries), tried in order on a transient Groq failure (429 / 5xx / timeout).
# This is a fallback BETWEEN GROQ MODELS only — any non-`groq:` entry is dropped.
# When unset, GROQ_MODEL above is used as a single-model chain.
# LLM_CHAT_CHAIN=groq:openai/gpt-oss-20b,groq:openai/gpt-oss-120b
# Optional `groq:<model-id>` override for the cheap fact-audit call (defaults to
# the head of the chat chain).
# LLM_AUDIT_MODEL=groq:openai/gpt-oss-20b

# ---------------------------------------------------------------------------
# Embeddings — NOT an LLM inference provider. Groq exposes no embeddings
# endpoint, so RAG embeddings stay on Gemini's text-embedding model (768 dims,
# the pgvector column size). This is a retrieval dependency only. If you ever
# re-embed with another provider you must also resize the pgvector column.
# ---------------------------------------------------------------------------
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-embeddings-api-key
GEMINI_EMBED_MODEL=text-embedding-004
EMBED_DIMENSIONS=768

# RAG token budget (keeps prompts within free-tier tokens-per-minute limits).
RAG_TOP_K=5
RAG_MAX_CONTEXT_TOKENS=6000

# ---------------------------------------------------------------------------
# Web Research mode (optional). A missing search key disables the Web tab with
# a friendly message. SERVER ONLY — never expose these to the browser.
# SEARCH_PROVIDER=tavily            # "tavily" or "brave"
# Tavily: https://app.tavily.com
# TAVILY_API_KEY=your-tavily-key
# Brave Search: https://brave.com/search/api/
# BRAVE_SEARCH_API_KEY=your-brave-key

# ---------------------------------------------------------------------------
# Market-data provider (ingestion pipeline — scripts/server only).
# Tapetide (https://developers.tapetide.com) is the primary NSE/BSE provider.
# Free tier: 50 successful requests/day, no card. Create a token at
# https://tapetide.com/settings/tokens (format: tpt_rt_...). When TAPETIDE_API_KEY
# is unset, the pipeline falls back to the optional Yahoo Finance path.
TAPETIDE_API_KEY=your-tapetide-token
# Max time (ms) the fetch pipeline will wait on a single 429 Retry-After before
# aborting with an actionable message (so a CLI never blocks for a multi-hour
# quota reset). Default 60000 (60s).
# TAPETIDE_MAX_RETRY_MS=60000

# Optional secondary market-data provider (not used by the default pipeline)
FINNHUB_API_KEY=your-finnhub-api-key

# Public site URL (used for OAuth redirects). Use the Vercel URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret to protect scheduled/cron endpoints
CRON_SECRET=your-cron-secret

