# ---------------------------------------------------------------------------
# StockLens environment variables
# Copy this file to `.env.local` (Next.js) / `.env` (scripts) and fill in.
# Never commit real values.
# ---------------------------------------------------------------------------

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — SERVER + SCRIPTS ONLY. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Gemini via Vercel AI SDK
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key
GEMINI_CHAT_MODEL=gemini-2.0-flash
# Optional ordered fallback chain (comma-separated). Tried in order on
# rate-limit/5xx/timeout; GEMINI_CHAT_MODEL is always the final fallback.
# Used only when LLM_CHAT_CHAIN (below) is NOT set.
# GEMINI_CHAT_MODELS=gemini-2.5-flash,gemini-2.0-flash
GEMINI_EMBED_MODEL=text-embedding-004
EMBED_DIMENSIONS=768

# ---------------------------------------------------------------------------
# Multi-provider chat chain (optional). Ordered, comma-separated
# `provider:model` entries, tried in order on rate-limit / 5xx / timeout.
# Providers whose API key (below) is missing are skipped silently. When unset,
# the app falls back to the Gemini-only chain above (backward compatible).
# Free-tier limits are PER ORGANIZATION and change often — check each provider
# console. Replace <model-id> with a model your account can use.
# LLM_CHAT_CHAIN=groq:<model-id>,huggingface:<model-id>,google:<model-id>
# Optional provider:model used for the cheap fact-audit call (defaults to the
# head of the chat chain).
# LLM_AUDIT_MODEL=google:gemini-2.0-flash

# Groq (https://console.groq.com) — server only.
GROQ_API_KEY=your-groq-api-key
# Hugging Face via its OpenAI-compatible router (https://huggingface.co/settings/tokens).
HUGGINGFACE_API_KEY=your-huggingface-token
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1

# RAG token budget (keeps prompts within free-tier tokens-per-minute limits).
RAG_TOP_K=5
RAG_MAX_CONTEXT_TOKENS=6000

# ---------------------------------------------------------------------------
# Web Research mode (optional). A missing search key disables the Web tab with
# a friendly message. SERVER ONLY — never expose these to the browser.
# SEARCH_PROVIDER=tavily            # "tavily" or "brave"
# Tavily: https://app.tavily.com
# TAVILY_API_KEY=your-tavily-key
# Brave Search: https://brave.com/search/api/
# BRAVE_SEARCH_API_KEY=your-brave-key

# ---------------------------------------------------------------------------
# Market-data provider (ingestion pipeline — scripts/server only).
# Tapetide (https://developers.tapetide.com) is the primary NSE/BSE provider.
# Free tier: 50 successful requests/day, no card. Create a token at
# https://tapetide.com/settings/tokens (format: tpt_rt_...). When TAPETIDE_API_KEY
# is unset, the pipeline falls back to the optional Yahoo Finance path.
TAPETIDE_API_KEY=your-tapetide-token

# Optional secondary market-data provider (not used by the default pipeline)
FINNHUB_API_KEY=your-finnhub-api-key

# Public site URL (used for OAuth redirects). Use the Vercel URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret to protect scheduled/cron endpoints
CRON_SECRET=your-cron-secret

